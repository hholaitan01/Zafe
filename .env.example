# TrustFlow AI — environment variables
#
# Copy this file to `.env.local` and fill in what you have.
# With NO key set, the AI features run in offline "demo mode" (deterministic
# heuristics) so the app still works on stage. Add the key to go live.

# Anthropic API key — enables real Claude calls for the three AI features.
# Get one at https://console.anthropic.com/ . Leave blank for demo mode.
ANTHROPIC_API_KEY=

# Optional: override the model the AI features use (defaults to claude-opus-5).
# TRUSTFLOW_AI_MODEL=claude-opus-5

# --- Auth (Supabase) ---
# With BOTH set, the Login screen uses real Supabase auth (email + Google).
# With neither set, login runs in "demo mode" (a local stand-in session) so
# the flow still works on stage. Find these in your Supabase project settings
# → API. They're public (browser-readable) by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for storing deals in Supabase (see lib/deals/schema.sql).
# With this + NEXT_PUBLIC_SUPABASE_URL set, deals persist to the `deals` table.
# Without it, deals use a seeded in-memory demo store. NEVER expose this key
# to the browser — it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (ALAT — Jerry's rails) ---
# With NO keys set, the money-moves are simulated (fake collection account,
# instant "paid", fake payout ref) so the whole escrow flow still demos.
# Collection (ALATPay) and payout (ALAT Wallet) are separate products with
# separate keys, so each can go live on its own.
#
# ALATPay — collecting the buyer's money into escrow (self-serve merchant portal).
ALATPAY_API_KEY=
ALATPAY_BUSINESS_ID=
#
# ALAT Wallet — paying the seller / refunding the buyer (bank-issued key; request early).
ALAT_WALLET_API_KEY=
ALAT_ESCROW_POOL_ACCOUNT=

# Signature secret ALATPay signs webhook callbacks with (HMAC). Set this to
# authenticate callbacks in a mock-collection deployment. Confirm the scheme with ALAT.
ALATPAY_WEBHOOK_SECRET=

# --- KYC (seller identity verification — Dojah) ---
# With NO provider set, live sellers stay UNVERIFIED (payouts locked) and demo
# mode treats them as verified. Set KYC_PROVIDER=dojah + the keys to verify a
# seller's BVN/vNIN against the name they entered. Get keys at https://dojah.io .
# The ID number is used to verify and never stored. Sandbox test BVN: 22222222222.
KYC_PROVIDER=
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# https://api.dojah.io for live, https://sandbox.dojah.io to test.
DOJAH_BASE_URL=

# --- Ops ---
# Shared secret for the scheduled auto-release cron (/api/deals/auto-release).
# Vercel Cron sends it as a Bearer token; unset leaves that endpoint open.
CRON_SECRET=

# --- Notifications (seller invites & escrow alerts — Resend) ---
# With NO key set, notification emails are recorded to an in-memory outbox and
# logged (demo), so the invite/alert flow works with zero keys. Set the key +
# a verified from-address to actually send. Get a key at https://resend.com .
RESEND_API_KEY=
EMAIL_FROM=

# Public base URL used in notification email links (e.g. the register/claim CTA).
NEXT_PUBLIC_APP_URL=

# --- Dispute review queue (admin) ---
# Comma-separated emails allowed to open /admin/disputes and settle escalated
# disputes. In demo mode the queue is open; in live mode it's gated to this list
# (empty = nobody has reviewer access).
ADMIN_EMAILS=
