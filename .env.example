# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ALATPay — merchant gateway, collects buyer payments (register at alatpay.ng)
ALATPAY_API_KEY=
ALATPAY_BUSINESS_ID=

# ALAT Wallet Services — bank-grade wallet/payout APIs, requires bank sign-off
# (start this request on Day 1 — it's the slowest thing to arrive)
ALAT_WALLET_API_KEY=
ALAT_ESCROW_POOL_ACCOUNT=

# AI
OPENAI_API_KEY=
# or, if using Gemini instead:
# GEMINI_API_KEY=

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
